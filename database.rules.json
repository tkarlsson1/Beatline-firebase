{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        ".read": true,
        ".write": true
      }
    },
    "reportedTracks": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$trackId": {
        ".write": "newData.exists()",
        ".validate": "newData.hasChildren(['spotifyId', 'title', 'artist', 'year', 'reportedAt'])",
        "spotifyId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "artist": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "year": { ".validate": "(newData.isString() && newData.val().length <= 10) || newData.isNumber()" },
        "reportedAt": { ".validate": "newData.isNumber()" },
        "reportedByTeam": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "$other": { ".validate": false }
      }
    },
    "flaggedTracks": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'"
    },
    "standardLists": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$listId": {
        ".validate": "newData.hasChildren(['songs'])"
      }
    },
    "verifiedTracks": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'"
    },
    "users": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userPlaylists": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$playlistId": {
          ".validate": "newData.hasChildren(['songs'])"
        }
      }
    }
  }
}
