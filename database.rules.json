{
  "rules": {
    ".read": false,
    ".write": false,
    "games": {
      "$gameId": {
        ".read": true,
        ".write": "data.exists() || (auth != null && newData.child('host').val() === auth.uid && newData.child('createdAt').isNumber() && $gameId.length == 6 && $gameId.matches(/^[A-Z0-9]+$/))"
      }
    },
    "reportedTracks": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$trackId": {
        ".write": "newData.exists() && $trackId.length == 22 && $trackId.matches(/^[A-Za-z0-9]+$/) && newData.child('gameId').isString() && newData.child('gameId').val().length == 6 && newData.child('gameId').val().matches(/^[A-Z0-9]+$/) && root.child('games').child(newData.child('gameId').val()).exists()",
        ".validate": "newData.hasChildren(['spotifyId', 'title', 'artist', 'year', 'reportedAt'])",
        "spotifyId": { ".validate": "newData.isString() && newData.val().length <= 64" },
        "title": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "artist": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "year": { ".validate": "(newData.isString() && newData.val().length <= 10) || newData.isNumber()" },
        "reportedAt": { ".validate": "newData.isNumber()" },
        "reportedByTeam": { ".validate": "newData.isString() && newData.val().length <= 100" },
        "gameId": { ".validate": "newData.isString() && newData.val().length == 6" },
        "$other": { ".validate": false }
      }
    },
    "flaggedTracks": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'"
    },
    "standardLists": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$listId": {
        ".validate": "newData.hasChildren(['songs'])"
      }
    },
    "verifiedTracks": {
      ".read": true,
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'"
    },
    "yearReviews": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'"
    },
    "users": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userPlaylists": {
      ".read": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      ".write": "auth != null && auth.uid == 'rtEO2DAFwfM4KdujZrFblspbwpu1'",
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "$playlistId": {
          ".validate": "newData.hasChildren(['songs'])"
        }
      }
    }
  }
}
